# Telegram bot token from @BotFather
BOT_TOKEN=

# Neon Postgres connection string (postgresql://...)
DATABASE_URL=

# Groq API key
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: path to words file (one word per line)
WORDS_FILE=words.txt

# Clip window around the word (seconds)
CLIP_BEFORE=2
CLIP_AFTER=3

# Telegram send pacing (seconds between messages)
SEND_DELAY=0.2
